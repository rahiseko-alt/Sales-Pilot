# Copy to .env. Do not commit real credentials.
# Default AI provider is Claude Code subscription (dashboard setting).
# First run: claude auth login
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=180

# Optional alternative: choose OpenAI in dashboard to use these keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Existing dedicated AgentMail inbox ID / address.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Live sends also require dry_run=false in dashboard settings.
# auto_send=true enables autonomous sending without per-message approval.
SALES_ALLOW_LIVE_SEND=no

# Optional custom DB location. Leave unset for data/sales.sqlite3.
# SALES_DB_PATH=C:/path/to/sales.sqlite3

# Optional Paperclip bridge destination.
SALES_AGENT_URL=http://127.0.0.1:8765
